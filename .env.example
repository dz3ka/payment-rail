# Copy to .env for local development. NEVER commit a real .env or real secrets.
# Signer keys are intentionally NOT configured here — see docs/threat-model.md.

# --- Core ---
PAYMENT_RAIL_ENV=dev
PAYMENT_RAIL_LOG_LEVEL=info
PAYMENT_RAIL_SHUTDOWN_TIMEOUT_SECONDS=10

# --- Postgres (docker-compose service: postgres) ---
PAYMENT_RAIL_POSTGRES_DSN=postgres://payment_rail:payment_rail@localhost:5432/payment_rail?sslmode=disable

# --- Redpanda / Kafka (docker-compose service: redpanda) ---
PAYMENT_RAIL_KAFKA_BROKERS=localhost:19092

# --- OpenTelemetry (docker-compose service: otel-collector) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=payment-rail

# --- Signer (isolated gRPC service) ---
# Loopback by default: slice-1 has no mTLS/caller-auth, so never bind a public interface.
PAYMENT_RAIL_SIGNER_GRPC_ADDR=127.0.0.1:9090
# Path to the secret-free key manifest (see signer.keyring.example.json). Key files it points to are NOT committed.
PAYMENT_RAIL_SIGNER_KEYRING=signer.keyring.json
