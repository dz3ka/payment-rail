# Copy to .env for local development. NEVER commit a real .env or real secrets.
# Signer keys are intentionally NOT configured here — see docs/threat-model.md.

# --- Core ---
CONDUIT_ENV=dev
CONDUIT_LOG_LEVEL=info
CONDUIT_SHUTDOWN_TIMEOUT_SECONDS=10

# --- Postgres (docker-compose service: postgres) ---
CONDUIT_POSTGRES_DSN=postgres://conduit:conduit@localhost:5432/conduit?sslmode=disable

# --- Redpanda / Kafka (docker-compose service: redpanda) ---
CONDUIT_KAFKA_BROKERS=localhost:19092

# --- OpenTelemetry (docker-compose service: otel-collector) ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=conduit
